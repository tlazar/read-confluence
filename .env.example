# Copy to .env and fill in.  .env is gitignored - never commit a real token.

# Base URL of the client's Confluence, including any context path.
# Client-hosted (Data Center / Server) examples:
#   https://confluence.client.com
#   https://intranet.client.com/confluence
CONFLUENCE_BASE_URL=https://confluence.example.com

# Personal Access Token.  In Confluence, top-right avatar > Settings >
# Personal Access Tokens > Create token.  Sent as an Authorization: Bearer header.
CONFLUENCE_TOKEN=

# Default space key, so you can omit it on the command line.  Optional.
CONFLUENCE_SPACE=

# TLS.  Leave unset for a normal public cert.  For a private/internal CA, set
# this to the path of the CA bundle .pem.  Set to false to skip verification
# (last resort - only on a network you trust).
# CONFLUENCE_VERIFY=/etc/ssl/certs/client-ca.pem

# Optional politeness controls.  Unset means no artificial delay, which is fine
# for normal use - every request is a sequential read-only GET.  Set a rate if
# the client's ops team wants a guaranteed ceiling.
# CONFLUENCE_RATE=5           # max requests per second
# CONFLUENCE_MAX_CALLS=1000   # abort a run after this many calls

# Only for Atlassian Cloud, which needs Basic auth with your account email.
# Leave this UNSET for client-hosted Confluence, or auth will fail.
# CONFLUENCE_EMAIL=tlazar@capitaltg.com
